DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Storage documents (S3-compatible - Garage en local/staging, tout autre endpoint S3 fonctionne)
NUXT_S3_ENDPOINT=http://localhost:3900
NUXT_S3_REGION=garage
NUXT_S3_ACCESS_KEY_ID=<s3-access-key-id>
NUXT_S3_SECRET_ACCESS_KEY=<s3-secret-access-key>
NUXT_PUBLIC_SITE_URL=http://localhost:3000
# Auth (Better Auth) - générer avec `npx @better-auth/cli secret` ou `openssl rand -base64 32`
BETTER_AUTH_SECRET=<au-moins-32-caracteres-aleatoires>
# Envoi des emails magic-link (Resend)
RESEND_API_KEY=<resend-api-key>
# À définir sur "staging" uniquement sur le déploiement de staging (affiche le bandeau d'avertissement)
NUXT_PUBLIC_APP_ENV=production
NUXT_DOCUMENTS_BUCKET=<s3-bucket-name>

# Rate limiting - optionnel en production multi-instance
# Installer ioredis (npm install ioredis) et décommenter la config dans nuxt.config.ts
# REDIS_URL=redis://<host>:<port>
