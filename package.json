{
  "name": "crm-binom",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "start": "node .output/server/index.mjs",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "test:e2e": "npx playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx app/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "db:up": "docker compose -f compose.dev.yml up -d --wait",
    "db:down": "docker compose -f compose.dev.yml down",
    "db:reset:local": "tsx scripts/reset-local-db.ts && npm run db:migrate && npm run db:seed",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1135.0",
    "@aws-sdk/s3-request-presigner": "^3.1135.0",
    "@formkit/drag-and-drop": "^0.6.1",
    "@iconify-json/lucide": "^1.2.134",
    "@iconify-json/simple-icons": "^1.2.95",
    "@nuxt/ui": "4.11.1",
    "better-auth": "^1.7.5",
    "dotenv": "^18.0.0",
    "drizzle-orm": "^0.45.1",
    "nuxt": "4.5.2",
    "postgres": "^3.4.7",
    "resend": "^6.28.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@emnapi/wasi-threads": "2.1.0",
    "@nuxt/eslint": "^1.12.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.1",
    "drizzle-kit": "^0.31.8",
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "rolldown": "1.2.9",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.2.1"
  },
  "packageManager": "npm@11.6.0",
  "overrides": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@emnapi/wasi-threads": "2.1.0",
    "@nuxt/icon": "2.3.1",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.4"
    }
  }
}
